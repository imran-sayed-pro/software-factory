{
  "version": 1,
  "profile": "typescript",
  "baseBranch": "main",
  "workers": {
    "max": 3,
    "command": [
      "claude",
      "-p",
      "{prompt}",
      "--permission-mode",
      "acceptEdits",
      "--output-format",
      "stream-json",
      "--verbose",
      "--plugin-dir",
      "{pluginDir}",
      "--add-dir",
      "{runDir}",
      "--allowedTools",
      "{allowedTools}"
