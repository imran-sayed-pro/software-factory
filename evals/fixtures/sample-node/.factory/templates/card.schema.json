{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory work card",
  "type": "object",
  "required": ["id", "spec", "title", "description", "acceptance", "verification", "dependsOn", "files", "size", "risk", "rollback", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
    "spec": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 90 },
    "description": { "type": "string", "minLength": 20 },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 5 } },
    "verification": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "manual": { "type": "array", "items": { "type": "string" } },
        "qaSurface": { "type": "string", "enum": ["none", "browser", "api", "cli", "ios-simulator", "ios-device"] }
      }
    },
    "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^C-[0-9]{3,}$" } },
    "files": {
      "type": "object",
      "required": ["allow"],
      "properties": { "allow": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "size": { "type": "string", "enum": ["XS", "S", "M", "L"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "highRiskReasons": { "type": "array", "items": { "type": "string" } },
    "rollback": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["draft", "ready", "running", "review", "blocked", "done", "merged", "archived"] },
    "notes": { "type": "string" }
  }
}
