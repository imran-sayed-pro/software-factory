{
  "name": "python",
  "description": "Python: Django, FastAPI, Flask, libraries and CLIs.",
  "detect": { "anyFile": ["pyproject.toml", "requirements.txt", "setup.py", "setup.cfg"] },
  "packageManager": { "lockfiles": { "uv.lock": "uv", "poetry.lock": "poetry" }, "default": "pip" },
  "commands": {
    "install": "{pm_install}",
    "typecheck": "mypy .",
    "lint": "ruff check .",
    "test": "pytest -q",
    "coverage": "pytest -q --cov --cov-report=lcov:coverage/lcov.info",
    "build": "python -m compileall -q .",
    "e2e": "pytest -q -m e2e",
    "auditDeps": "osv-scanner scan source -r .",
    "secrets": "gitleaks detect --redact --no-banner",
    "sast": "semgrep scan --config p/default --error --quiet"
  },
  "pmInstall": { "uv": "uv sync", "poetry": "poetry install", "pip": "pip install -r requirements.txt" },
  "coverageReport": "coverage/lcov.info",
  "testFilePattern": "(^|/)(test_[^/]+\\.py|[^/]+_test\\.py|tests/.+\\.py)$",
  "devServer": { "command": "", "url": "http://localhost:8000" },
  "qaSurfaces": ["api", "cli", "browser"]
}
